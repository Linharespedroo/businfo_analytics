# ─── BigQuery ────────────────────────────────────────────────────────────
# Path to a service-account JSON, OR set GOOGLE_APPLICATION_CREDENTIALS_JSON
# with the JSON contents inline (preferred for GitHub Actions secrets).
GOOGLE_APPLICATION_CREDENTIALS=./.secrets/bq-sa.json
# GOOGLE_APPLICATION_CREDENTIALS_JSON='{"type":"service_account", ...}'

BQ_PROJECT_ID=lpdev-6b8e0
BQ_DATASET=analytics_472265609
BQ_LOCATION=US
# how many days back to include in aggregates
BQ_LOOKBACK_DAYS=90
BQ_TIMEZONE=America/Sao_Paulo

# ─── Neon Postgres (BusInfo) ─────────────────────────────────────────────
NEON_DATABASE_URL=postgres://user:password@ep-host.neon.tech/BusInfo?sslmode=require

# ─── Build ──────────────────────────────────────────────────────────────
# Base path used by GitHub Pages (e.g. "/businfo_analytics"). Leave empty
# for a user/organization page or local dev.
NEXT_PUBLIC_BASE_PATH=

# ─── Coletor SIM/SPTrans (src/main.py) ───────────────────────────────────
# Credenciais usadas pelo Playwright para logar no portal SIM. Em produção
# devem vir dos GitHub Secrets de mesmo nome.
SIM_LOGIN=trsantos
SIM_PASSWORD=

# (opcionais)
# SIM_ENTRY_URL=http://sim.sptrans.com.br/
# SIM_OUTPUT_PATH=data/mapeamento_veiculos.json
# SIM_COMPRESS_THRESHOLD_MB=10
# SIM_DIAGNOSTICS_DIR=diagnostics
# SIM_USER_AGENT=Mozilla/5.0 ...
# LOG_LEVEL=INFO
